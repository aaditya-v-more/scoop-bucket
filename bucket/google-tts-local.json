{
    "version": "0.4.0",
    "description": "Run Google's on-device text-to-speech voices locally, with a command line and an HTTP server.",
    "homepage": "https://github.com/aaditya-v-more/google-tts-local",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aaditya-v-more/google-tts-local/releases/download/v0.4.0-windows/google-tts-local-0.4.0-windows-x64.zip",
            "hash": "589c4864dcffd3871c1ff37e408bf71f364c16c8079b3baabc48d97226260896",
            "extract_dir": "google-tts-local-0.4.0-windows-x64"
        }
    },
    "bin": "gtts.exe",
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') { & \"$dir\\gtts.exe\" service uninstall }"
    ],
    "notes": [
        "Download the engine and voice packs (from Google's ChromeOS mirror), then start the HTTP server at sign-in:",
        "  gtts fetch",
        "  gtts service install",
        "The server listens on 127.0.0.1:5591. Downloaded voices are kept in %LOCALAPPDATA%\\google-tts-local.",
        "Scoop can't update or uninstall it while the server runs. Stop it first, then start it again after updating:",
        "  gtts service uninstall",
        "  scoop update google-tts-local",
        "  gtts service install"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/aaditya-v-more/google-tts-local/releases",
        "regex": "\"tag_name\":\\s*\"v([\\d.]+)-windows\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aaditya-v-more/google-tts-local/releases/download/v$version-windows/google-tts-local-$version-windows-x64.zip",
                "extract_dir": "google-tts-local-$version-windows-x64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
